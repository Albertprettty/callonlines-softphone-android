<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_darker">

    <com.callonlines.softphone.OrbitView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/cl_logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_status_dot"
                android:backgroundTint="@color/status_pending" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Conectado" />

            <ImageView
                android:id="@+id/btnLogout"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_logout"
                android:padding="9dp"
                android:contentDescription="Cerrar sesión"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4" />

        <EditText
            android:id="@+id/etNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="38sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:inputType="phone"
            android:cursorVisible="true"
            android:longClickable="true"
            android:textCursorDrawable="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:columnCount="3"
            android:rowCount="4"
            android:paddingHorizontal="20dp">

            <!-- 1 -->
            <LinearLayout android:id="@+id/key1" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="1" />
                <TextView style="@style/DialLetters" android:text=" " />
            </LinearLayout>
            <!-- 2 -->
            <LinearLayout android:id="@+id/key2" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="2" />
                <TextView style="@style/DialLetters" android:text="ABC" />
            </LinearLayout>
            <!-- 3 -->
            <LinearLayout android:id="@+id/key3" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="3" />
                <TextView style="@style/DialLetters" android:text="DEF" />
            </LinearLayout>
            <!-- 4 -->
            <LinearLayout android:id="@+id/key4" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="4" />
                <TextView style="@style/DialLetters" android:text="GHI" />
            </LinearLayout>
            <!-- 5 -->
            <LinearLayout android:id="@+id/key5" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="5" />
                <TextView style="@style/DialLetters" android:text="JKL" />
            </LinearLayout>
            <!-- 6 -->
            <LinearLayout android:id="@+id/key6" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="6" />
                <TextView style="@style/DialLetters" android:text="MNO" />
            </LinearLayout>
            <!-- 7 -->
            <LinearLayout android:id="@+id/key7" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="7" />
                <TextView style="@style/DialLetters" android:text="PQRS" />
            </LinearLayout>
            <!-- 8 -->
            <LinearLayout android:id="@+id/key8" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="8" />
                <TextView style="@style/DialLetters" android:text="TUV" />
            </LinearLayout>
            <!-- 9 -->
            <LinearLayout android:id="@+id/key9" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="9" />
                <TextView style="@style/DialLetters" android:text="WXYZ" />
            </LinearLayout>
            <!-- * -->
            <LinearLayout android:id="@+id/keyStar" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="*" />
                <TextView style="@style/DialLetters" android:text=" " />
            </LinearLayout>
            <!-- 0 -->
            <LinearLayout android:id="@+id/key0" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="0" />
                <TextView style="@style/DialLetters" android:text="+" />
            </LinearLayout>
            <!-- # -->
            <LinearLayout android:id="@+id/keyHash" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="#" />
                <TextView style="@style/DialLetters" android:text=" " />
            </LinearLayout>

        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <View
                android:layout_width="56dp"
                android:layout_height="1dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnCall"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/bg_call_button"
                android:padding="22dp"
                android:contentDescription="Llamar"
                android:elevation="6dp"
                app:tint="@color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_backspace"
                android:padding="16dp"
                android:contentDescription="Borrar"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
