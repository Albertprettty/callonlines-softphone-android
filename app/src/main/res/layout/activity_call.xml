<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_darker">

    <com.callonlines.softphone.OrbitView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:letterSpacing="0.3"
            tools:text="LLAMANDO" />

        <TextView
            android:id="@+id/tvRemote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            tools:text="100" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/primary_cyan"
            android:textSize="22sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="10dp"
            tools:text="00:00" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/activeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/btnMute"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/ic_mic"
                android:background="@drawable/bg_action_circle"
                android:padding="20dp"
                android:contentDescription="Mute"
                app:tint="@color/text_primary" />

            <Space
                android:layout_width="40dp"
                android:layout_height="0dp" />

            <ImageView
                android:id="@+id/btnSpeaker"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/ic_speaker_off"
                android:background="@drawable/bg_action_circle"
                android:padding="20dp"
                android:contentDescription="Altavoz"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnHangup"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_call_end"
            android:background="@drawable/bg_hangup"
            android:padding="26dp"
            android:contentDescription="Colgar"
            android:elevation="8dp"
            app:tint="@color/white" />

        <LinearLayout
            android:id="@+id/incomingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnDecline"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_call_end"
                android:background="@drawable/bg_hangup"
                android:padding="22dp"
                android:contentDescription="Rechazar"
                android:elevation="6dp"
                app:tint="@color/white" />

            <Space
                android:layout_width="48dp"
                android:layout_height="0dp" />

            <ImageView
                android:id="@+id/btnAnswer"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/bg_call_button"
                android:padding="22dp"
                android:contentDescription="Contestar"
                android:elevation="6dp"
                app:tint="@color/white" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</FrameLayout>
